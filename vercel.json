{
  "cleanUrls": true,
  "trailingSlash": false,
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "X-Frame-Options",
          "value": "SAMEORIGIN"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(), geolocation=()"
        },
        {
          "key": "Content-Security-Policy",
          "value": "default-src 'self'; script-src 'self' 'unsafe-inline' 'unsafe-eval' https://cdn.jsdelivr.net https://cdnjs.cloudflare.com https://checkout.razorpay.com https://*.supabase.co; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com data:; img-src 'self' data: https: blob: https://cdn.simpleicons.org https://via.placeholder.com; connect-src 'self' https://*.supabase.co wss://*.supabase.co https://api.razorpay.com https://lumberjack.razorpay.com https://lumberjack-cx.razorpay.com; frame-src 'self' https://api.razorpay.com; child-src 'self' https://api.razorpay.com;"
        }
      ]
    },
    {
      "source": "/widget.js",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=3600, stale-while-revalidate=86400"
        },
        {
          "key": "Access-Control-Allow-Origin",
          "value": "*"
        }
      ]
    }
  ],
  "rewrites": [
    { "source": "/dashboard", "destination": "/app.html" },
    { "source": "/pricing", "destination": "/pricing.html" },
    { "source": "/guide", "destination": "/guide.html" },
    { "source": "/widget-builder", "destination": "/widget-builder.html" },
    { "source": "/privacy", "destination": "/privacy.html" },
    { "source": "/terms", "destination": "/terms.html" },
    { "source": "/refund", "destination": "/refund.html" },
    { "source": "/contact", "destination": "/contact.html" },
    { "source": "/ai-chatbot-for-website", "destination": "/ai-chatbot-for-website.html" },
    { "source": "/whatsapp-marketing", "destination": "/whatsapp-marketing.html" },
    { "source": "/lead-tracking", "destination": "/lead-tracking.html" },
    { "source": "/google-ads-app-install", "destination": "/google-ads-app-install.html" },
    { "source": "/meta-ads-management", "destination": "/meta-ads-management.html" },
    { "source": "/partners", "destination": "/partners.html" },
    { "source": "/blog", "destination": "/blog.html" }
  ]
}
